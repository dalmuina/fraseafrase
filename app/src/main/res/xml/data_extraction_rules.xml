<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 y superior: copia en la nube y transferencia entre dispositivos.
    Solo exclusiones (sin include) para que el progreso y los ajustes sigan entrando en la copia.
    El catálogo se regenera desde los assets, así que no se copia.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="catalog.db" />
        <exclude domain="database" path="catalog.db-wal" />
        <exclude domain="database" path="catalog.db-shm" />
        <exclude domain="database" path="catalog.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="catalog.db" />
        <exclude domain="database" path="catalog.db-wal" />
        <exclude domain="database" path="catalog.db-shm" />
        <exclude domain="database" path="catalog.db-journal" />
    </device-transfer>
</data-extraction-rules>
